-- Adoções por mês
Set lc_time_names = 'pt_BR';
select monthname(Data), count(ID_pedido)
from pedido_adocao
where Status = 'Aprovado' 
group by monthname(Data);

-- Vacinas que vencem em 15 dias
select v.Nome_vacina, av.Data_proxima_dose
from Vacina v, Aplicacao_vacina av
where v.ID_vacina = av.ID_vacina and av.Data_proxima_dose between curdate() and date_add(curdate(), interval 15 day);

