select a.nome, a.porte, a.sexo, e.Nome_especie
from Animal a, Especie e
where a.ID_especie = e.ID_especie and a.Situacao = 'Disponivel';

select e.Nome_especie, v.Nome_vacina
from Especie e, Vacina v, Especie_Vacina es
where e.ID_especie = es.ID_especie and es.ID_vacina = v.ID_vacina;

select a.nome, v.Nome_vacina, av.Data_aplicacao
from Animal a, Vacina v, Aplicacao_vacina av
where a.ID_animal = av.ID_animal and av.ID_vacina = v.ID_vacina;

select e.Nome_especie, count(a.nome)
from Especie e, Animal a
where e.ID_especie = a.ID_especie
group by e.Nome_especie;

create view vw_pedidos_pendentes as
select p.ID_pedido, p.Data, a.nome
from Pedido_adocao p, Animal a
where a.ID_animal = p.ID_animal;

select * from vw_pedidos_pendentes;

create view vw_adotantes as
select Nome, Email, Telefone
from Usuario
where Adotante = 'Sim';

select Nome
from vw_adotantes
order by Nome asc;







