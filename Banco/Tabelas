create database Abrigo;
use Abrigo;

create table Usuario(
CPF char (11) primary key,
Senha varchar(50) not null,
Email varchar (50) not null unique,
Adotante varchar (50) not null,
Nome varchar (50) not null,
Endereco varchar (50) not null,
Telefone char (11) not null unique,
Nascimento char (10) not null
);

create table Especie(
ID_especie int primary key,
Nome_especie varchar (50) not null unique
);

create table Vacina (
ID_vacina int primary key,
Nome_vacina varchar(20) not null unique
);

create table Animal (
ID_animal int primary key,
Nome varchar(15) not null,
Porte varchar(5) not null,
Sexo varchar(10) not null,
data_resgate char(10) not null,
Situacao varchar(20) not null,
Idade_estimada int not null,
ID_especie int not null,
Foto longtext,

foreign key (ID_especie) references Especie(ID_especie));

create table Pedido_adocao (
ID_pedido int primary key,
Status varchar(10) not null,
Data char(10) not null,
ID_animal int not null,

foreign key (ID_animal) references Animal(ID_animal));

create table Pedido_adocao_Usuario (
CPF char(11) not null,
ID_pedido int not null,

primary key (CPF, ID_pedido),

foreign key (CPF) references Usuario(CPF),
foreign key (ID_pedido) references Pedido_adocao(ID_pedido)
);

create table Especie_Vacina (
ID_especie int not null,
ID_vacina int not null,

primary key(ID_especie, ID_vacina),

foreign key (ID_especie) references Especie(ID_especie),
foreign key (ID_vacina) references Vacina(ID_vacina)
);

create table Aplicacao_vacina (

ID_animal int not null,
ID_vacina int not null,
Data_aplicacao date not null,
primary key(ID_animal, ID_vacina),

foreign key (ID_animal) references Animal(ID_animal),
foreign key (ID_vacina) references Vacina(ID_vacina)
);

